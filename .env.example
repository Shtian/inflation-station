# Path to SQLite database (must be outside the repo for persistence across pulls)
DATABASE_URL=file:/home/shtian/inflation-station-data/data.db

# Optional (self-hosting): pm2 process name and port used by ecosystem.config.js and update.sh.
# Give each clone its own values to run several instances side by side (see README).
PM2_APP_NAME=inflation-station
PORT=3000

# Optional: OpenAI API key for AI-powered categorization and monthly reviews
OPENAI_API_KEY=
OPENAI_MESSAGE_CLEANUP_ENABLED=false
OPENAI_HINT_SUGGESTIONS_ENABLED=true

# Optional: GitHub repo (owner/name) that the in-app feedback widget files issues in.
# Setting it shows the widget; it also needs OPENAI_API_KEY and an authenticated `gh` (gh auth login)
# for the user running the app.
# FEEDBACK_GITHUB_REPO=Shtian/inflation-station

# Optional: TypeSafe API key for Jev, which suggests categories and CSV column mappings during import
TYPESAFE_API_KEY=
