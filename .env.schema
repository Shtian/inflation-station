# Inflation Station config. This file is the reference for every env var the
# app, the build, and the self-hosting scripts read. Put real values in a
# gitignored `.env`; values set in the process environment win over it.
# See https://varlock.dev/env-spec for the decorator syntax.
#
# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# SQLite database the app opens. Keep it outside the repo so it survives pulls.
# Read when the server boots, so one build can serve several databases.
# @required @dynamic @type=string(startsWith="file:")
# @example="file:/home/shtian/inflation-station-data/data.db"
DATABASE_URL=

# API key for AI categorization, import cleanup, hint suggestions, chats, and
# monthly reviews. Leave empty to turn those features off.
# @sensitive @dynamic
OPENAI_API_KEY=

# Lets the import flow clean up transaction messages with OpenAI.
# @type=boolean @dynamic
OPENAI_MESSAGE_CLEANUP_ENABLED=true

# Lets the category editor suggest classifier hints with OpenAI.
# @type=boolean @dynamic
OPENAI_HINT_SUGGESTIONS_ENABLED=true

# TypeSafe API key for Jev, which suggests categories and CSV column mappings
# during import. Leave empty to turn Jev off.
# @sensitive @dynamic
TYPESAFE_API_KEY=

# GitHub repo (owner/name) the in-app feedback widget files issues in. Setting
# it shows the widget, which also needs OPENAI_API_KEY and an authenticated
# `gh` (gh auth login) for the user running the app.
# @dynamic @type=string(matches=regex("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"))
# @example="Shtian/inflation-station"
FEEDBACK_GITHUB_REPO=

# Sentry DSN for error monitoring in the browser and the server. Leave empty to
# turn Sentry off. Baked into the build, so rebuild (./update.sh) after a change.
# @type=url
VITE_SENTRY_DSN=

# Sentry environment name. Give each instance its own name to tell them apart.
# Read when the server boots, so one image can serve several instances. Wins
# over VITE_SENTRY_ENVIRONMENT.
# @dynamic
SENTRY_ENVIRONMENT=

# Deprecated: set SENTRY_ENVIRONMENT instead. Fallback Sentry environment for
# pm2 clones that still set it. Baked into the build.
VITE_SENTRY_ENVIRONMENT=production

# Sentry org and project slugs for source map upload during build.
SENTRY_ORG=
SENTRY_PROJECT=

# Sentry org auth token (Settings → Auth Tokens). Source maps upload during
# build only when it is set.
# @sensitive
SENTRY_AUTH_TOKEN=

# Commit the build was made from, shown shortened in the footer and used as the
# Sentry release. The Docker build sets it; other builds read it from git.
SOURCE_COMMIT=

# pm2 process name used by ecosystem.config.js and update.sh. Defaults to
# inflation-station there. Give each clone its own name to run several
# instances side by side (see README).
PM2_APP_NAME=

# Port the server listens on under pm2. ecosystem.config.js defaults it to
# 3000. It has no schema default, because Varlock exports resolved values
# into process.env and a PORT there overrides `pnpm dev --port`.
# @type=port
PORT=
