generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum CategoryKind {
  EXPENSE
  INCOME
  TRANSFER
}

enum PaymentType {
  CARD
  TRANSFER
  EFT
  CASH
  OTHER
}

enum SuggestionSource {
  RULE
  OPENAI
  JEV
  HISTORY
}

enum MonthlyReviewStatus {
  GENERATING
  GENERATED
  FAILED
}

model Account {
  id          String         @id @default(cuid())
  name        String         @unique
  institution String?
  isActive    Boolean        @default(true)
  /// ColumnMapping JSON the user last confirmed for this account's CSV export.
  csvColumnMapping   Json?
  /// Normalized headers the mapping was confirmed on; reuse requires a match.
  csvHeaderSignature String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  transactions Transaction[]
  categoryRules CategoryRule[]
  importReviewSessions ImportReviewSession[]
}

model Category {
  id                      String                   @id @default(cuid())
  name                    String                   @unique
  kind                    CategoryKind             @default(EXPENSE)
  classifierHint          String?
  transactions            Transaction[]
  categoryRules           CategoryRule[]
  categorizationSuggestions CategorizationSuggestion[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Transaction {
  id               String                     @id @default(cuid())
  accountId        String
  account          Account                    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  categoryId       String?
  category         Category?                  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bookingDate      DateTime
  amountNok        Decimal
  currency         String
  normalizedMerchant String
  merchant         String?
  paymentType      PaymentType                @default(OTHER)
  note             String?
  suggestions      CategorizationSuggestion[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([accountId, bookingDate])
  @@index([categoryId])
}

model CategoryRule {
  id               String       @id @default(cuid())
  accountId        String?
  account          Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId       String
  category         Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  merchantContains String
  paymentType      PaymentType?
  priority         Int          @default(100)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([accountId, priority])
  @@index([categoryId])
}

model CategorizationSuggestion {
  id                  String           @id @default(cuid())
  transactionId       String
  transaction         Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  suggestedCategoryId String
  suggestedCategory   Category         @relation(fields: [suggestedCategoryId], references: [id], onDelete: Cascade)
  source              SuggestionSource
  confidence          Float?
  reasoning           String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([transactionId, source])
  @@index([suggestedCategoryId])
}

model ImportReviewSession {
  id           String            @id @default(cuid())
  accountId    String
  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rows         ImportReviewRow[]
  invalidCount Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([accountId, createdAt])
}

model ImportReviewRow {
  id                 String              @id @default(cuid())
  sessionId          String
  session            ImportReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rowNumber          Int
  bookingDate        DateTime
  amountNok          Decimal
  currency           String
  normalizedMerchant String
  paymentType        PaymentType         @default(OTHER)
  sender             String
  recipient          String
  name               String
  title              String
  categoryId         String?
  suggestionSource   SuggestionSource?
  suggestionConfidence Float?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([sessionId, rowNumber])
}

model MonthlyReview {
  id           String              @id @default(cuid())
  monthStart   DateTime            @unique
  status       MonthlyReviewStatus @default(GENERATING)
  reviewText   String?
  errorMessage String?
  generatedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model MonthlyReviewSystemPrompt {
  id         String   @id
  promptText String?
  modelId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MessageCleanupSettings {
  id              String   @id
  promptText      String?
  modelId         String?
  reasoningEffort String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
